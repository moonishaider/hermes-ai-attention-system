@@ -0,0 +1,39 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { transcribeWithOneRetry } from './transcribe-with-retry'
+
+describe('transcribeWithOneRetry', () => {
+  const audio = new Blob(['voice'], { type: 'audio/webm' })
+
+  it('returns the first non-empty transcript without retrying', async () => {
+    const transcribe = vi.fn(async () => '  a complete request  ')
+
+    await expect(transcribeWithOneRetry(audio, transcribe)).resolves.toBe('a complete request')
+    expect(transcribe).toHaveBeenCalledTimes(1)
+  })
+
+  it('retries an empty transcript using the same in-memory recording', async () => {
+    const transcribe = vi.fn().mockResolvedValueOnce('   ').mockResolvedValueOnce('recovered request')
+
+    await expect(transcribeWithOneRetry(audio, transcribe)).resolves.toBe('recovered request')
+    expect(transcribe).toHaveBeenNthCalledWith(1, audio)
+    expect(transcribe).toHaveBeenNthCalledWith(2, audio)
+  })
+
+  it('retries one provider failure and then succeeds', async () => {
+    const transcribe = vi.fn().mockRejectedValueOnce(new Error('temporary failure')).mockResolvedValueOnce('recovered')
+
+    await expect(transcribeWithOneRetry(audio, transcribe)).resolves.toBe('recovered')
+    expect(transcribe).toHaveBeenCalledTimes(2)
+  })
+
+  it('never retries more than once', async () => {
+    const failure = new Error('still unavailable')
+    const transcribe = vi.fn(async () => {
+      throw failure
+    })
+
+    await expect(transcribeWithOneRetry(audio, transcribe)).rejects.toBe(failure)
+    expect(transcribe).toHaveBeenCalledTimes(2)
+  })
+})
