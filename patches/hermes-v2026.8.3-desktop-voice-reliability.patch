@@ -0,0 +1,28 @@
+/**
+ * Transcribe one in-memory recording, retrying exactly once when the provider
+ * fails or returns an empty transcript. The Blob is never persisted.
+ */
+export async function transcribeWithOneRetry(
+  audio: Blob,
+  transcribe: (audio: Blob) => Promise<string>
+): Promise<string> {
+  let firstError: unknown = null
+
+  for (let attempt = 0; attempt < 2; attempt += 1) {
+    try {
+      const transcript = (await transcribe(audio)).trim()
+
+      if (transcript) {
+        return transcript
+      }
+    } catch (error) {
+      firstError ??= error
+    }
+  }
+
+  if (firstError) {
+    throw firstError
+  }
+
+  return ''
+}
