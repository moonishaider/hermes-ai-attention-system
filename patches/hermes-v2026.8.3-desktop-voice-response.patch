+/**
+ * Project a voice-mode response into the part that should actually be spoken.
+ *
+ * Voice turns ask the model to lead with a short conversational answer and put
+ * citations/structured detail after `Details for screen:`. The full reply stays
+ * visible in chat, while TTS stops at that explicit boundary. Older replies (or
+ * providers that ignore the contract) safely fall back to the normal sanitizer.
+ */
+export function projectVoiceSpeech(text: string): VoiceSpeechProjection {
+  const markerIndex = text.indexOf(VOICE_SCREEN_DETAILS_MARKER)
+  let spoken = markerIndex >= 0 ? text.slice(0, markerIndex) : text
+
+  // While the response streams, hold back a trailing partial marker so TTS
+  // never begins saying "Details for scr..." before the full boundary lands.
+  if (markerIndex < 0) {
+    const maxPrefix = Math.min(VOICE_SCREEN_DETAILS_MARKER.length - 1, text.length)
+
+    for (let length = maxPrefix; length > 0; length -= 1) {
+      if (VOICE_SCREEN_DETAILS_MARKER.startsWith(text.slice(-length))) {
+        spoken = text.slice(0, -length)
+        break
+      }
+    }
+  }
+
+  return {
+    text: sanitizeTextForSpeech(spoken),
+    complete: markerIndex >= 0
+  }
+}
