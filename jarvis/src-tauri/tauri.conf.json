{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.moonishaider.jarvis",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "width": 1260,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "hud",
        "title": "Ask Jarvis",
        "url": "index.html",
        "width": 680,
        "height": 190,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Syed Moonis Haider",
    "shortDescription": "Personal Hermes intelligence assistant",
    "longDescription": "Jarvis is Syed's source-backed, context-separated desktop assistant powered by the protected Hermes backend.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}
